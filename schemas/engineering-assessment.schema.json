{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDKA Engineering Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "scope",
    "evidence",
    "requirements",
    "gaps",
    "decision",
    "institution",
    "product_context"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "observed_at",
          "finding",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date"
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "observed",
              "inferred",
              "not_verified"
            ]
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "authority"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirement_id",
          "current_state",
          "evidence_refs",
          "recommendation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "current_state": {
            "enum": [
              "met",
              "partial",
              "missing",
              "not_verified"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decision": {
      "enum": [
        "review_required",
        "accepted",
        "rejected"
      ]
    },
    "institution": {
      "const": "sertaodigital"
    },
    "product_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "skill"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^sertaodigitalorg/[A-Za-z0-9_.-]+$"
        },
        "skill": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
