{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDKA Connector Operation - planning contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source_id",
    "purpose",
    "scope",
    "authorization",
    "execution",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_hosts",
        "allowed_paths",
        "methods"
      ],
      "properties": {
        "allowed_hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9.-]+$"
          }
        },
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "const": "GET"
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "approved_by"
      ],
      "properties": {
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "read_only",
        "timeout_seconds",
        "max_requests"
      ],
      "properties": {
        "mode": {
          "const": "dry_run"
        },
        "read_only": {
          "const": true
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "max_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "redaction_required"
      ],
      "properties": {
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "redaction_required": {
          "const": true
        }
      }
    }
  }
}
