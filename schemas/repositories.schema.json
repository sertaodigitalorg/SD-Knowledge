{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sertaodigital.org/schemas/repositories.schema.json",
  "title": "Repositories Registry Schema",
  "description": "Schema for repositories.yaml - Repository catalog",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "repositories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "type", "status"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Repository name"
          },
          "url": {
            "type": ["string", "null"],
            "format": "uri",
            "description": "Repository URL"
          },
          "type": {
            "type": "string",
            "enum": ["software", "knowledge-base", "infrastructure", "documentation", "utility"],
            "description": "Repository type"
          },
          "status": {
            "type": "string",
            "enum": ["active", "pending-validation", "deprecated", "planned", "archived"],
            "description": "Repository status"
          },
          "description": {
            "type": "string",
            "description": "What the repository contains"
          },
          "upstream": {
            "type": ["string", "null"],
            "format": "uri",
            "description": "Upstream repository URL if fork"
          },
          "parent_product": {
            "type": ["string", "null"],
            "description": "Parent product ID if applicable"
          }
        }
      }
    }
  }
}
